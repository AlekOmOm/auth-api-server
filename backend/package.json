{
  "name": "auth-system_nodejs",
  "version": "1.0.0",
  "description": "",
  "main": "server.js",
  "scripts": {
    "start": "node server.js NODE_ENV=production",
    "run": "node server.js",
    "dev": "npm run nodemonDev",
    "nodemonDev": "nodemon server.js",
    "init-db": "node ./src/db/setupDB.js",
    "reset-db": "node ./src/db/setupDB.js --delete",
    "test": "vitest run",
    "test:unit": "vitest run --testNamePattern=\"^(?!.*Integration Tests)\"",
    "test:integration": "vitest run --testNamePattern=\"Integration Tests\"",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:setup": "npm run test:db:up && npm run test:wait-for-db",
    "test:teardown": "npm run test:db:down",
    "test:db:up": "docker-compose -f ../docker-compose.yml up db -d",
    "test:db:down": "docker-compose -f ../docker-compose.yml down",
    "test:wait-for-db": "node -e \"const testSetup = require('./src/services/__tests__/setup/testSetup.js'); testSetup.waitForDatabase().then(() => console.log('Database ready')).catch(console.error);\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlekOmOm/auth-system_NodeJS.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/AlekOmOm/auth-system_NodeJS/issues"
  },
  "homepage": "https://github.com/AlekOmOm/auth-system_NodeJS#readme",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "express-validator": "^7.2.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.0",
    "pg-format": "^1.0.4",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "supertest": "^7.1.0",
    "vitest": "^3.1.2"
  }
}